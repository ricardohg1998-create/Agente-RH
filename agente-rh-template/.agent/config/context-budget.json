{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": 1,
  "warn": {
    "maxLines": 350,
    "maxChars": 14000
  },
  "critical": {
    "quickLayer": {
      "maxLines": 200,
      "maxChars": 12000
    },
    "duplication": {
      "minParagraphChars": 180,
      "minFiles": 3
    }
  },
  "scanPaths": [
    "README.md",
    "AGENTS.md",
    "brain",
    "docs",
    ".agent/templates",
    ".agent/workflows",
    ".agent/rules",
    ".agent/skills",
    ".agent/scripts"
  ],
  "textExtensions": [
    ".md",
    ".txt",
    ".json",
    ".yml",
    ".yaml"
  ],
  "quickLayerFiles": [
    "brain/now.md",
    "brain/current-state.md",
    "brain/stack.md",
    "brain/deep-summary.md"
  ]
}
