{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": 1,
  "mode": "quick-layer-strict",
  "quickLayer": {
    "files": [
      "brain/now.md",
      "brain/current-state.md",
      "brain/stack.md",
      "brain/deep-summary.md"
    ],
    "requiredOn": [
      "relevant_change",
      "new_blocker",
      "scope_change",
      "new_persistent_instruction"
    ]
  },
  "deepLayer": {
    "files": [
      "brain/project-overview.md",
      "brain/architecture.md",
      "brain/decisions.md",
      "brain/milestones.md",
      "brain/backlog.md",
      "brain/open-questions.md",
      "brain/technical-debt.md",
      "brain/pitfalls-and-errors.md",
      "brain/ideas.md",
      "brain/changelog.md",
      "brain/skills-available.md",
      "brain/workflows-index.md",
      "brain/user-instructions.md"
    ],
    "updatePolicy": "if_applies"
  },
  "severityMap": {
    "high": ["architecture_change", "security_risk", "critical_bug"],
    "medium": ["new_dependency", "workflow_change"],
    "low": ["wording_update", "formatting_only"]
  }
}
